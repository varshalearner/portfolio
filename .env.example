# Template only. This file is committed and pushed to GitHub, so it must never
# contain real passwords, keys or tokens. Put real values in:
#   - .env.local (gitignored) for local development
#   - Vercel → Project → Settings → Environment Variables for the live site

# ---- Admin panel (/admin) ----
# Password used to sign in at /admin/login. Required to enable the admin panel.
ADMIN_PASSWORD=

# ---- Blog posts in Supabase ----
# When both are set, blog posts and post images are stored in Supabase instead of
# the MDX files in content/blog. Saves from /admin go live in seconds, no redeploy.
#
# One-time setup:
#   1. Supabase dashboard → SQL Editor → run supabase/schema.sql
#   2. Set both values in .env.local and on Vercel (Supabase → Project Settings → API Keys)
#   3. npm run posts:import     (copies the existing MDX posts into Supabase)
#
# SUPABASE_SERVICE_ROLE_KEY must be a "Secret" key (sb_secret_...) or the legacy
# "service_role" key. The publishable key (sb_publishable_...) does not work: it
# has no access to the posts table. Server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Saving site content in production (Vercel) ----
# Site text (data/content.json) is still a file. On Vercel the filesystem is
# read-only, so the admin panel commits content edits to GitHub and Vercel
# redeploys. Create a fine-grained token at
# https://github.com/settings/personal-access-tokens with "Contents: Read and write"
# on this repository only, and set it on Vercel. Leave GITHUB_TOKEN empty locally:
# the admin panel then writes straight to the files in this folder.
# (Without Supabase, blog posts are files too and use this same GitHub setup.)
GITHUB_TOKEN=
GITHUB_REPO=varshalearner/portfolio
GITHUB_BRANCH=master
